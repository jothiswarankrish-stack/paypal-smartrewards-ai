# ====================================================================
# PayPal SmartRewards AI - Environment Configuration Example
# ====================================================================

# 1. PayPal Developer Platform (Sandbox)
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=sandbox_mock_client_id_for_dev
PAYPAL_CLIENT_SECRET=sandbox_mock_client_secret_for_dev
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sandbox_mock_client_id_for_dev

# 2. Database & Supabase (PostgreSQL / SQLite hybrid)
# For local SQLite development (no configuration needed):
DATABASE_URL=sqlite:///./smartrewards.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. AI / LLM Integration (Gemini / OpenAI API / Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# 4. Web & Server
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
SECRET_KEY=smartrewards-dev-secret-key-paypal-hackathon-2026
