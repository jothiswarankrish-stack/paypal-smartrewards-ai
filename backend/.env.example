# PayPal Sandbox Configuration
# Obtain credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=sandbox_mock_client_id_for_dev
PAYPAL_CLIENT_SECRET=sandbox_mock_client_secret_for_dev
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox

# Database Configuration (Supabase PostgreSQL or fallback local SQLite)
# Example Supabase Postgres URL: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./smartrewards.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI / LLM Configuration (Gemini API or OpenAI API)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Security
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=smartrewards-dev-secret-key-paypal-hackathon-2026
